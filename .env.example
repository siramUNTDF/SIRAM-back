# Copiá este archivo a .env y ajustalo. Nunca subas .env al repositorio.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Sin POSTGRES_DB se usa SQLite (solo desarrollo y tests).
# POSTGRES_DB=siram
# POSTGRES_USER=siram
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Producción detrás de HTTPS
# DJANGO_SECURE_SSL=true

SIRAM_2FA_OBLIGATORIO=false
SIRAM_EDICION_ENTRE_ORGANISMOS=true
SIRAM_VENTANA_DUPLICADOS_DIAS=7
